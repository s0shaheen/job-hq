# --- Google (existing secret, reused) ---
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# HQ_SHEET_ID=            # optional override; normally from hq.config.yaml

# --- LLM (existing secret, reused) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Notifications (optional overrides; defaults in hq.config.yaml) ---
# HQ_NTFY_TOPIC=
# HQ_OPS_NTFY_TOPIC=
MONITOR_OPS_NTFY_TOPIC=   # legacy alias, still honored

# --- Wide discovery layer ---
APIFY_TOKEN=              # existing secret; hiring.cafe actor
THEIRSTACK_API_KEY=       # optional free-tier safety net

# --- Simplify import (best-effort; see docs/RUNBOOK.md re-auth) ---
SIMPLIFY_AUTH_COOKIE=     # 'authorization' cookie JWT
SIMPLIFY_CSRF=            # 'csrf' cookie value

# --- Resume publishing (Apps Script web app) ---
APPSSCRIPT_UPLOAD_URL=
APPSSCRIPT_UPLOAD_SECRET=

# --- The v2 Postgres store (SHEET-SUNSET; db/README.md) ---
# Absent, every pg path skips loudly and the engine is sheet-only.
SUPABASE_URL=             # https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=     # service-role key: ENGINE ONLY, never ships to a browser
HQ_PG_USER_ID=            # the owner's users.id (uuid). Single-user only —
                          # once hq.config.yaml has a users: map, each user's
                          # block carries its own pg_user_id and this is ignored

# Which store the engine is writing for real. Unset = Phase A (the sheet is the
# system of record, pg is a best-effort echo). `first_class` = Phase C: the sweep
# writes postings and FAILS if it can't, join applies email events to
# applications under the 0010 status lock, and heartbeats land in both stores.
# The flip is a documented procedure, not a toggle: docs/RUNBOOK.md § The store lane.
# HQ_PG_WRITES=first_class

# Which store feeds the sweep its company list (SHEET-SUNSET Phase B).
# HQ_COMPANIES_SOURCE=pg

# --- The digest email (SHEET-SUNSET C3; the engine sends it, not Apps Script) ---
HQ_MAIL_SENDER=           # verified SES From address; on Lambda, Terraform sets it (infra/terraform/mail.tf)
HQ_DIGEST_EMAIL=          # unset | engine. unset = the digest is composed but nothing is sent
HQ_DIGEST_KEYS=           # kid:secret,oldkid:oldsecret — one-click link signing keys, NEWEST FIRST
HQ_WEBAPP_URL=            # absolute https origin the digest links point at; never relative, never localhost
