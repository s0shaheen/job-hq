# --- Google (existing secret, reused) ---
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# HQ_SHEET_ID=            # optional override; normally from hq.config.yaml

# --- LLM (existing secret, reused) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Notifications (optional overrides; defaults in hq.config.yaml) ---
# HQ_NTFY_TOPIC=
# HQ_OPS_NTFY_TOPIC=
MONITOR_OPS_NTFY_TOPIC=   # legacy alias, still honored

# --- Wide discovery layer ---
APIFY_TOKEN=              # existing secret; hiring.cafe actor
THEIRSTACK_API_KEY=       # optional free-tier safety net

# --- Simplify import (best-effort; see docs/RUNBOOK.md re-auth) ---
SIMPLIFY_AUTH_COOKIE=     # 'authorization' cookie JWT
SIMPLIFY_CSRF=            # 'csrf' cookie value

# --- Resume publishing (Apps Script web app) ---
APPSSCRIPT_UPLOAD_URL=
APPSSCRIPT_UPLOAD_SECRET=
