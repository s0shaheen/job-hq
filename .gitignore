__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node / editor app
editor/node_modules/
editor/.next/
editor/.vercel/

# Personal source conversations — local only, never push
Claude-Exporter-Career-*/

# Resume build artifacts
resume/out/
resume/out-alt/
resume/.alt.cv.yaml
**/.build/
*.aux *.log *.fdb_latexmk *.fls *.synctex.gz

# macOS / Drive noise
.DS_Store
Icon?
.playwright-mcp/

# Google Doc pointer (meaningless off this machine)
*.gdoc

# Committed migration import data (sanitized; scout CSV has no prefs/password)
!tracker/data/*.csv
monitor/companies.expansion.csv.state.json

# design-sync (claude.ai/design) — staged scripts, build output, machine state.
# Everything else under .design-sync/ is durable and IS committed: config.json,
# NOTES.md, ds-entry.tsx, build-css.mjs, previews/.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
# Generated by .design-sync/build-css.mjs — the compiled Tailwind v4 stylesheet
# the converter ships as cfg.cssEntry. Must live under webapp/ because cssEntry
# is bounded to the package dir. Never edit; it is rebuilt every sync.
webapp/.ds-styles.css

# Personal material that lives in this working tree and must never enter the
# repository. `interview-prep/` is the owner's preparation for live interviews;
# the recordings are other people's voices. One `git add -A` is all that stands
# between these and permanent history, and history is not retractable — see
# docs/pilot-launch/20-personal-vault-audit.md, Step 0.
interview-prep/
*.m4a
*.mp3
*.wav

# Machine-specific symlinks. Both of these were TRACKED, with absolute paths
# baked into the blob: `webapp/node_modules` -> this checkout (committed by
# accident in #141), and `applications` -> a Google Drive folder whose path
# carries the owner's email address. On any other machine, or in a fresh clone,
# a tracked absolute symlink is a broken path where a real directory is
# expected — it cost two test runs a MODULE_NOT_FOUND before anyone looked.
# tests/core/test_no_absolute_symlinks.py fails the build if one returns.
webapp/node_modules
/applications

# local agent/CLI state — never committed. .claude holds agent worktrees
# (personal content); supabase/.temp is Supabase CLI machine state. The one
# exception is .claude/rules/ — path-scoped agent rules (e.g. the legacy
# quarantine, issue #188) are repo policy and ARE committed.
.claude/*
!.claude/rules/
supabase/.temp/

# vault-split step 0 (20-personal-vault-audit.md §8/§9): live interview
# material and call recordings must never be one `git add -A` from history.
interview-prep/
*.m4a
*.wav
*.aac
