# Copy to .env.local for local dev; set the same vars in Vercel for deploys.

# The one gate on the app. Long random phrase (20+ chars) — there is no rate
# limiting beyond a small delay, so entropy is the defense.
EDITOR_PASSCODE=

# Fine-grained PAT for the single repo. Permissions: Contents (Read and write)
# + Actions (Read-only, for the render-run status chip). See README for minting.
GITHUB_TOKEN=

# Repo the editor commits to, and the branch the render workflow watches.
GITHUB_REPO=s0shaheen/job-hq
GITHUB_BRANCH=main

# Files the editor edits.
RESUME_PATH=resume/base.yaml
DESIGN_PATH=resume/design.yaml

# Optional: where this deployment's render workflow publishes the finished PDF.
# Both are optional and both are configuration — unset means no link is shown,
# and the label exists so an install that publishes to S3 (or nowhere) is not
# told to "Open Drive folder".
PUBLISH_LINK_URL=
PUBLISH_LINK_LABEL=
