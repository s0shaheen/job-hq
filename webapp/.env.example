# Supabase project credentials — Dashboard -> Project Settings -> API.
# Both are safe to expose to the browser: authorization is done by RLS,
# never by hiding keys. NEVER put a service_role / secret key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- server-only (NO NEXT_PUBLIC_ prefix — never inlined into the browser bundle) ---
# The warm-intro finder (Layer 2) calls the harvestapi Apify actor server-side.
# Same token the engine's wide layer uses — one Apify account. Unset = the finder's
# vendor cannot start a run (demo mode uses a deterministic fake and needs nothing).
APIFY_TOKEN=YOUR-APIFY-TOKEN
# The warm finder's fit-analysis pass (one Haiku call per search, fail-safe to the
# deterministic ranking if unset). Same key the engine uses. Never NEXT_PUBLIC.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY
# Per-user warm searches per rolling 24h (spend cap). Optional; defaults to 20.
# HQ_WARM_DAILY_CAP=20
# Merged/ranked results per warm search. Optional; defaults to 40 (clamped 10..50).
# Cost is unchanged by this — 3 personas x 1 page x $0.10 regardless.
# HQ_WARM_MAX_RESULTS=40

# Copy to .env.local for local dev (never commit .env.local).
